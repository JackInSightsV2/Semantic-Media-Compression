{
  "schema_metadata": {
    "id": "business_plan_distillation",
    "version": "1.0.0",
    "released_at": "2025-01-27T00:00:00Z",
    "draft": "2020-12",
    "hash": "<SHA256 of schema_definition only>",
    "description": "Semantic distillation schema capsule for business plans and strategic planning documents.",
    "authors": ["Byte Insights"],
    "license": "proprietary",
    "protection": {
      "integrity_model": "sha256(schema_definition)",
      "storage_guidelines": "Immutable. Hash stored on-chain when necessary.",
      "ip_protection_notes": "Schema capsule is designed to be self-contained for IP locking."
    }
  },
  "schema_definition": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "BusinessPlanDistillationBlueprint",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "executive_summary",
      "company_description",
      "market_analysis",
      "products_and_services",
      "marketing_strategy",
      "operations",
      "management_team",
      "financial_projections",
      "funding_requirements",
      "document_structure",
      "tone_metadata"
    ],
    "properties": {
      "executive_summary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["overview", "mission"],
        "properties": {
          "overview": { "type": "string" },
          "mission": { "type": "string" },
          "vision": { "type": ["string", "null"] },
          "key_objectives": {
            "type": "array",
            "items": { "type": "string" }
          },
          "value_proposition": { "type": ["string", "null"] }
        }
      },
      "company_description": {
        "type": "object",
        "additionalProperties": false,
        "required": ["company_name", "legal_structure"],
        "properties": {
          "company_name": { "type": "string" },
          "legal_structure": { "type": "string" },
          "location": { "type": ["string", "null"] },
          "founding_date": { "type": ["string", "null"] },
          "history": { "type": ["string", "null"] },
          "current_status": { "type": ["string", "null"] }
        }
      },
      "market_analysis": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_market"],
        "properties": {
          "target_market": { "type": "string" },
          "market_size": { "type": ["string", "null"] },
          "market_trends": {
            "type": "array",
            "items": { "type": "string" }
          },
          "competition": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["competitor_name"],
              "properties": {
                "competitor_name": { "type": "string" },
                "strengths": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "weaknesses": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "competitive_advantage": { "type": ["string", "null"] }
              }
            }
          },
          "market_opportunity": { "type": ["string", "null"] }
        }
      },
      "products_and_services": {
        "type": "object",
        "additionalProperties": false,
        "required": ["offerings"],
        "properties": {
          "offerings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "description"],
              "properties": {
                "name": { "type": "string" },
                "description": { "type": "string" },
                "features": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "pricing_model": { "type": ["string", "null"] },
                "unique_selling_points": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "development_stage": { "type": ["string", "null"] },
          "intellectual_property": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "marketing_strategy": {
        "type": "object",
        "additionalProperties": false,
        "required": ["strategy"],
        "properties": {
          "strategy": { "type": "string" },
          "channels": {
            "type": "array",
            "items": { "type": "string" }
          },
          "pricing_strategy": { "type": ["string", "null"] },
          "sales_process": { "type": ["string", "null"] },
          "customer_acquisition": { "type": ["string", "null"] },
          "brand_positioning": { "type": ["string", "null"] }
        }
      },
      "operations": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operational_model"],
        "properties": {
          "operational_model": { "type": "string" },
          "facilities": {
            "type": "array",
            "items": { "type": "string" }
          },
          "supply_chain": { "type": ["string", "null"] },
          "technology": {
            "type": "array",
            "items": { "type": "string" }
          },
          "key_partnerships": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "management_team": {
        "type": "object",
        "additionalProperties": false,
        "required": ["team_members"],
        "properties": {
          "team_members": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "role"],
              "properties": {
                "name": { "type": "string" },
                "role": { "type": "string" },
                "background": { "type": ["string", "null"] },
                "expertise": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "organizational_structure": { "type": ["string", "null"] },
          "advisory_board": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "expertise": { "type": ["string", "null"] }
              }
            }
          }
        }
      },
      "financial_projections": {
        "type": "object",
        "additionalProperties": false,
        "required": ["projections"],
        "properties": {
          "projections": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["period", "revenue", "expenses"],
              "properties": {
                "period": { "type": "string" },
                "revenue": { "type": "string" },
                "expenses": { "type": "string" },
                "profit": { "type": ["string", "null"] },
                "assumptions": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "break_even_analysis": { "type": ["string", "null"] },
          "key_metrics": {
            "type": "array",
            "items": { "type": "string" }
          },
          "financial_assumptions": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "funding_requirements": {
        "type": "object",
        "additionalProperties": false,
        "required": ["amount_needed"],
        "properties": {
          "amount_needed": { "type": "string" },
          "use_of_funds": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["category", "amount"],
              "properties": {
                "category": { "type": "string" },
                "amount": { "type": "string" },
                "description": { "type": ["string", "null"] }
              }
            }
          },
          "funding_type": { "type": ["string", "null"] },
          "exit_strategy": { "type": ["string", "null"] },
          "return_on_investment": { "type": ["string", "null"] }
        }
      },
      "risks_and_challenges": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "identified_risks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["risk"],
              "properties": {
                "risk": { "type": "string" },
                "mitigation": { "type": ["string", "null"] },
                "probability": { "type": ["string", "null"] },
                "impact": { "type": ["string", "null"] }
              }
            }
          },
          "challenges": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "document_structure": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sections"],
        "properties": {
          "contents_list": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "has_contents": { "type": "boolean" },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "section_id": { "type": "string" },
                    "title": { "type": "string" },
                    "page": { "type": ["integer", "null"] }
                  }
                }
              }
            }
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "level"],
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "level": { "type": "integer", "minimum": 1, "maximum": 6 },
                "numbering": { "type": ["string", "null"] },
                "subsections": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "title", "level"],
                    "properties": {
                      "id": { "type": "string" },
                      "title": { "type": "string" },
                      "level": { "type": "integer" },
                      "numbering": { "type": ["string", "null"] }
                    }
                  }
                }
              }
            }
          },
          "tables": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "caption"],
              "properties": {
                "id": { "type": "string" },
                "caption": { "type": "string" },
                "section_id": { "type": ["string", "null"] },
                "description": { "type": ["string", "null"] }
              }
            }
          },
          "figures": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "caption"],
              "properties": {
                "id": { "type": "string" },
                "caption": { "type": "string" },
                "section_id": { "type": ["string", "null"] },
                "description": { "type": ["string", "null"] }
              }
            }
          }
        }
      },
      "tone_metadata": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "style": { "type": "string" },
          "formality": { "type": "string" },
          "persuasiveness": { "type": "string" },
          "key_phrases": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  },
  "operational_guidance": {
    "intended_use": "Semantic distillation of business plans and strategic planning documents.",
    "migration": {
      "supersedes": null,
      "migrates_cleanly": true,
      "notes": "First version of business plan distillation schema."
    }
  }
}


