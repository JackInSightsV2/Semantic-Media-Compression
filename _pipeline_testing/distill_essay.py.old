def pass3_methodology(paper_text: str, full_schema: Dict[str, Any], prompt_path: Path, schema_structure_path: Optional[Path] = None, run_timestamp: str = "") -> Dict[str, Any]:
    """
    Pass 3: Extract fields based on Pass 3 prompt template.
    Dynamically builds schema snippet based on what fields exist in the schema.
    """
