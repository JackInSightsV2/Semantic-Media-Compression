{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semantic-media-compression.local/schemas/essay-argumentative-distillation.schema.json",
  "title": "ArgumentativeEssayDistillationBlueprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "thesis",
    "claim_hierarchy",
    "evidence",
    "counterarguments",
    "assumptions_and_values",
    "structure_and_rhetoric",
    "implications",
    "sensitivities"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "0.0.1",
      "description": "Schema version of the distillation blueprint."
    },
    "thesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement"],
      "properties": {
        "statement": { "type": "string" },
        "problem_statement": { "type": "string" }
      }
    },
    "claim_hierarchy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["main_claims"],
      "properties": {
        "main_claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement"],
            "properties": {
              "id": { "type": "string" },
              "statement": { "type": "string" },
              "subclaims": {
                "type": "array",
                "items": { "type": "string" }
              },
              "depends_on": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "type", "description"],
        "properties": {
          "claim_id": { "type": "string" },
          "type": { "type": "string" },
          "description": { "type": "string" },
          "strength": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          }
        }
      }
    },
    "counterarguments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement"],
        "properties": {
          "id": { "type": "string" },
          "statement": { "type": "string" },
          "targets_claim_id": { "type": "string" },
          "reply": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["rebutted", "conceded", "unresolved"],
            "default": "unresolved"
          }
        }
      }
    },
    "assumptions_and_values": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assumptions", "value_judgments", "key_definitions"],
      "properties": {
        "assumptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "value_judgments": {
          "type": "array",
          "items": { "type": "string" }
        },
        "key_definitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["term", "definition"],
            "properties": {
              "term": { "type": "string" },
              "definition": { "type": "string" }
            }
          }
        }
      }
    },
    "structure_and_rhetoric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outline"],
      "properties": {
        "outline": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "purpose"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "purpose": { "type": "string" },
              "linked_claim_ids": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "rhetorical_techniques": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "implications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended_actions"],
      "properties": {
        "recommended_actions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "policy_or_decision_implications": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "sensitivities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["misinterpretation_risks"],
      "properties": {
        "misinterpretation_risks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sensitive_topics": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}


