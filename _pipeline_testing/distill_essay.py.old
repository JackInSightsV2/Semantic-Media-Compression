    if not pass3_fields:
        raise ValueError("No Pass 3 fields found in schema. Schema may not be compatible.")
    
    schema_snippet = {
        "type": "object",
        "additionalProperties": False,
        "required": pass3_required,
        "properties": pass3_fields,
    }
    
    # Format the user template with actual text
    user_msg = user_template.replace("{TEXT}", paper_text)
    
    attempt = 1
    while attempt <= 3:
