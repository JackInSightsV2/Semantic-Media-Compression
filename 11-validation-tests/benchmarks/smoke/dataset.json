{
  "schema_version": 1,
  "id": "synthetic-smoke-v1",
  "license": "Apache-2.0; original synthetic fixtures authored for this repository",
  "purpose": "Protocol smoke checks, not model ranking or narrative quality evidence",
  "split": "smoke",
  "cases": [
    {
      "id": "retention-01",
      "track": "decision",
      "input": {
        "evidence": [
          {
            "id": "e1",
            "timestamp_seconds": 12,
            "observation": "Mira hands Sol a key. Sol opens the locked exit using it."
          }
        ]
      },
      "questions": [
        {
          "id": "retain",
          "type": "binary",
          "prompt": "Does the key enable the observed exit opening?"
        },
        {
          "id": "relationship",
          "type": "choice",
          "prompt": "How is handing over the key related to opening the exit?",
          "options": [
            "unrelated",
            "enables",
            "contradicts"
          ]
        },
        {
          "id": "importance",
          "type": "score",
          "prompt": "Rate the key on 0=irrelevant, 1=context, 2=necessary for the observed action.",
          "range": [
            0,
            2
          ]
        }
      ],
      "expected": {
        "retain": true,
        "relationship": "enables",
        "importance": 2
      }
    },
    {
      "id": "missing-evidence-01",
      "track": "decision",
      "input": {
        "evidence": [
          {
            "id": "e2",
            "observation": "Mira is silent. Her hands are outside the frame."
          }
        ]
      },
      "questions": [
        {
          "id": "ring",
          "type": "choice",
          "prompt": "Does the evidence establish that Mira is wearing a ring?",
          "options": [
            "yes",
