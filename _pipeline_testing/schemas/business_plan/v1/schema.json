{
  "schema_metadata": {
    "id": "business_plan_distillation",
    "version": "1.0.0",
    "released_at": "2025-01-27T00:00:00Z",
    "draft": "2020-12",
    "hash": "<SHA256 of schema_definition only>",
    "description": "Semantic distillation schema capsule for business plans and strategic planning documents.",
    "authors": ["Byte Insights"],
    "license": "proprietary",
    "protection": {
      "integrity_model": "sha256(schema_definition)",
      "storage_guidelines": "Immutable. Hash stored on-chain when necessary.",
      "ip_protection_notes": "Schema capsule is designed to be self-contained for IP locking."
    },
    "distillation_config": {
      "passes": [
        {
          "name": "Pass 1",
          "fields": ["executive_summary", "company_description", "market_analysis"],
          "always_include": ["document_structure", "quotes_and_anecdotes", "tone_metadata"]
        },
        {
          "name": "Pass 2",
          "fields": ["products_and_services", "marketing_strategy"],
          "always_include": []
        },
        {
          "name": "Pass 3",
          "fields": ["operations", "management_team"],
          "always_include": []
        },
        {
          "name": "Pass 4",
          "fields": ["financial_projections", "funding_requirements", "risks_and_challenges"],
          "always_include": []
        },
        {
          "name": "Pass 5",
          "fields": [],
          "always_include": ["document_structure"]
        },
        {
          "name": "Pass 6",
          "fields": [],
          "always_include": ["document_structure"]
        },
        {
          "name": "Pass 7",
          "fields": [],
          "always_include": ["document_structure"]
        },
        {
          "name": "Pass 8",
          "fields": ["layout_metadata"],
          "always_include": []
        },
        {
          "name": "Pass 9",
          "fields": ["examples_and_case_studies"],
          "always_include": []
        }
      ]
    }
  },
  "schema_definition": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "BusinessPlanDistillationBlueprint",
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "section_item": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "level"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "level": { "type": "integer" },
          "numbering": { "type": ["string", "null"] },
          "subsections": {
            "type": "array",
            "items": { "$ref": "#/$defs/section_item" }
          }
        }
      }
    },
    "required": [
      "executive_summary",
      "company_description",
      "market_analysis",
      "products_and_services",
      "marketing_strategy",
      "operations",
      "management_team",
      "financial_projections",
      "funding_requirements",
      "document_structure",
      "quotes_and_anecdotes",
      "tone_metadata",
      "layout_metadata",
      "examples_and_case_studies"
    ],
    "properties": {
      "executive_summary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["overview", "mission"],
        "properties": {
          "overview": { "type": "string" },
          "mission": { "type": "string" },
          "vision": { "type": ["string", "null"] },
          "key_objectives": {
            "type": "array",
            "items": { "type": "string" }
          },
          "value_proposition": { "type": ["string", "null"] }
        }
      },
      "company_description": {
        "type": "object",
        "additionalProperties": false,
        "required": ["company_name", "legal_structure"],
        "properties": {
          "company_name": { "type": "string" },
          "legal_structure": { "type": "string" },
          "location": { "type": ["string", "null"] },
          "founding_date": { "type": ["string", "null"] },
          "history": { "type": ["string", "null"] },
          "current_status": { "type": ["string", "null"] }
        }
      },
      "market_analysis": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_market"],
        "properties": {
          "target_market": { "type": "string" },
          "market_size": { "type": ["string", "null"] },
          "market_trends": {
            "type": "array",
            "items": { "type": "string" }
          },
          "competition": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["competitor_name"],
              "properties": {
                "competitor_name": { "type": "string" },
                "strengths": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "weaknesses": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "competitive_advantage": { "type": ["string", "null"] }
              }
            }
          },
          "market_opportunity": { "type": ["string", "null"] }
        }
      },
      "products_and_services": {
        "type": "object",
        "additionalProperties": false,
        "required": ["offerings"],
        "properties": {
          "offerings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "description"],
              "properties": {
                "name": { "type": "string" },
                "description": { "type": "string" },
                "features": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "pricing_model": { "type": ["string", "null"] },
                "unique_selling_points": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "development_stage": { "type": ["string", "null"] },
          "intellectual_property": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "marketing_strategy": {
        "type": "object",
        "additionalProperties": false,
        "required": ["strategy"],
        "properties": {
          "strategy": { "type": "string" },
          "channels": {
            "type": "array",
            "items": { "type": "string" }
          },
          "pricing_strategy": { "type": ["string", "null"] },
          "sales_process": { "type": ["string", "null"] },
          "customer_acquisition": { "type": ["string", "null"] },
          "brand_positioning": { "type": ["string", "null"] }
        }
      },
      "operations": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operational_model"],
        "properties": {
          "operational_model": { "type": "string" },
          "facilities": {
            "type": "array",
            "items": { "type": "string" }
          },
          "supply_chain": { "type": ["string", "null"] },
          "technology": {
            "type": "array",
            "items": { "type": "string" }
          },
          "key_partnerships": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "management_team": {
        "type": "object",
        "additionalProperties": false,
        "required": ["team_members"],
        "properties": {
          "team_members": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "role"],
              "properties": {
                "name": { "type": "string" },
                "role": { "type": "string" },
                "background": { "type": ["string", "null"] },
                "expertise": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "organizational_structure": { "type": ["string", "null"] },
          "advisory_board": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "expertise": { "type": ["string", "null"] }
              }
            }
          }
        }
      },
      "financial_projections": {
        "type": "object",
        "additionalProperties": false,
        "required": ["projections"],
        "properties": {
          "projections": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["period", "revenue", "expenses"],
              "properties": {
                "period": { "type": "string" },
                "revenue": { "type": "string" },
                "expenses": { "type": "string" },
                "profit": { "type": ["string", "null"] },
                "assumptions": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "break_even_analysis": { "type": ["string", "null"] },
          "key_metrics": {
            "type": "array",
            "items": { "type": "string" }
          },
          "financial_assumptions": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "funding_requirements": {
        "type": "object",
        "additionalProperties": false,
        "required": ["amount_needed"],
        "properties": {
          "amount_needed": { "type": "string" },
          "use_of_funds": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["category", "amount"],
              "properties": {
                "category": { "type": "string" },
                "amount": { "type": "string" },
                "description": { "type": ["string", "null"] }
              }
            }
          },
          "funding_type": { "type": ["string", "null"] },
          "exit_strategy": { "type": ["string", "null"] },
          "return_on_investment": { "type": ["string", "null"] }
        }
      },
      "risks_and_challenges": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "identified_risks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["risk"],
              "properties": {
                "risk": { "type": "string" },
                "mitigation": { "type": ["string", "null"] },
                "probability": { "type": ["string", "null"] },
                "impact": { "type": ["string", "null"] }
              }
            }
          },
          "challenges": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "document_structure": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sections"],
        "properties": {
          "contents_list": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "has_contents": { "type": "boolean" },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "section_id": { "type": "string" },
                    "title": { "type": "string" },
                    "page": { "type": ["integer", "null"] }
                  }
                }
              }
            }
          },
          "sections": {
            "type": "array",
            "items": {
              "allOf": [
                { "$ref": "#/$defs/section_item" },
                {
                  "properties": {
                    "level": { "type": "integer", "minimum": 1, "maximum": 6 }
                  }
                }
              ]
            }
          },
          "tables": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "caption"],
              "properties": {
                "id": { "type": "string" },
                "caption": { "type": "string" },
                "section_id": { "type": ["string", "null"] },
                "description": { "type": ["string", "null"] },
                "table_data": {
                  "type": ["object", "null"],
                  "additionalProperties": true,
                  "description": "Full table data with rows and columns. Structure depends on table format."
                },
                "row_count": { "type": ["integer", "null"] },
                "column_count": { "type": ["integer", "null"] }
              }
            }
          },
          "figures": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "caption"],
              "properties": {
                "id": { "type": "string" },
                "caption": { "type": "string" },
                "section_id": { "type": ["string", "null"] },
                "description": { "type": ["string", "null"] }
              }
            }
          },
          "title_page": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": { "type": ["string", "null"] },
              "subtitle": { "type": ["string", "null"] },
              "author": { "type": ["string", "null"] },
              "author_affiliations": {
                "type": "array",
                "items": { "type": "string" }
              },
              "dedication": { "type": ["string", "null"] },
              "acknowledgments": { "type": ["string", "null"] }
            }
          },
          "appendix": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "has_appendix": { "type": "boolean" },
              "sections": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["citation"],
              "properties": {
                "id": { "type": ["string", "null"] },
                "citation": { "type": "string" },
                "authors": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "title": { "type": ["string", "null"] },
                "venue": { "type": ["string", "null"] },
                "year": { "type": ["integer", "null"] }
              }
            }
          }
        }
      },
      "quotes_and_anecdotes": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "text": { "type": "string" },
            "context": { "type": ["string", "null"] },
            "section_id": { "type": ["string", "null"] },
            "attribution": { "type": ["string", "null"] }
          }
        }
      },
      "tone_metadata": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "style": { "type": "string" },
          "urgency_level": { "type": "string" },
          "formality": { "type": "string" },
          "key_phrases": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "layout_metadata": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "format_type": {
            "type": "string",
            "description": "Document format: 'business_plan', 'strategic_plan', 'pitch_deck', 'financial_plan', etc."
          },
          "has_copyright": { "type": "boolean" },
          "copyright_notice": { "type": ["string", "null"] },
          "has_footnotes": { "type": "boolean" },
          "has_page_numbers": { "type": "boolean" },
          "header_content": { "type": ["string", "null"] },
          "footer_content": { "type": ["string", "null"] },
          "typography_style": {
            "type": "string",
            "description": "Typography style: 'plain_text', 'formatted', 'professional', etc."
          },
          "section_numbering_style": {
            "type": "string",
            "description": "How sections are numbered: 'arabic' (1, 2, 3), 'roman' (I, II, III), 'alphanumeric' (1a, 1b), 'none', etc."
          },
          "heading_style": {
            "type": "string",
            "description": "Heading formatting: 'numbered' (1. Title), 'unnumbered' (Title), 'mixed', etc."
          },
          "abstract_placement": {
            "type": "string",
            "description": "Where executive summary appears: 'before_title', 'after_title', 'after_intro', 'none'"
          },
          "citation_style_in_text": {
            "type": "string",
            "description": "How citations appear in text: 'author_year' (Smith 2020), 'numbered' ([1]), 'footnote', 'none', etc."
          },
          "reference_section_style": {
            "type": "string",
            "description": "Reference section format: 'numbered_list', 'author_year', 'footnotes', 'none', etc."
          },
          "paragraph_spacing": {
            "type": "string",
            "description": "Paragraph spacing: 'single', 'double', 'spaced' (blank lines between), 'compact'"
          },
          "list_formatting": {
            "type": "string",
            "description": "How lists are formatted: 'bullets', 'numbered', 'dashes', 'none', etc."
          },
          "section_transitions": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Observable patterns in how sections transition (e.g., 'abrupt', 'summary_before_next', 'continuation', etc.)"
          },
          "document_flow_pattern": {
            "type": "string",
            "description": "Overall document flow: 'chronological', 'thematic', 'problem_solution', 'strategic', 'financial', etc."
          }
        }
      },
      "examples_and_case_studies": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description"],
          "properties": {
            "description": { "type": "string" },
            "type": {
              "type": "string",
              "description": "Type: 'company_example', 'market_example', 'financial_example', 'case_study', 'success_story', 'industry_example', etc."
            },
            "section_id": { "type": ["string", "null"] },
            "specific_details": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Specific facts, numbers, names, dates, locations mentioned"
            },
            "citations": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Any in-text citations or reference IDs mentioned with this example"
            }
          }
        }
      }
    }
  },
  "operational_guidance": {
    "intended_use": "Semantic distillation of business plans and strategic planning documents.",
    "migration": {
      "supersedes": null,
      "migrates_cleanly": true,
      "notes": "First version of business plan distillation schema."
    }
  }
}

