{
  "schema_metadata": {
    "id": "technical_documentation_distillation",
    "version": "1.0.0",
    "released_at": "2025-01-27T00:00:00Z",
    "draft": "2020-12",
    "hash": "<SHA256 of schema_definition only>",
    "description": "Semantic distillation schema capsule for technical documentation including API manuals, user guides, and technical specifications.",
    "authors": ["Byte Insights"],
    "license": "proprietary",
    "protection": {
      "integrity_model": "sha256(schema_definition)",
      "storage_guidelines": "Immutable. Hash stored on-chain when necessary.",
      "ip_protection_notes": "Schema capsule is designed to be self-contained for IP locking."
    }
  },
  "schema_definition": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "TechnicalDocumentationDistillationBlueprint",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "overview",
      "api_endpoints",
      "authentication",
      "data_models",
      "error_handling",
      "examples",
      "document_structure",
      "tone_metadata"
    ],
    "properties": {
      "overview": {
        "type": "object",
        "additionalProperties": false,
        "required": ["purpose", "description"],
        "properties": {
          "purpose": { "type": "string" },
          "description": { "type": "string" },
          "version": { "type": ["string", "null"] },
          "base_url": { "type": ["string", "null"] },
          "target_audience": { "type": ["string", "null"] },
          "prerequisites": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "api_endpoints": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "path", "description"],
          "properties": {
            "method": { "type": "string" },
            "path": { "type": "string" },
            "description": { "type": "string" },
            "parameters": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "type", "required"],
                "properties": {
                  "name": { "type": "string" },
                  "type": { "type": "string" },
                  "required": { "type": "boolean" },
                  "description": { "type": ["string", "null"] },
                  "default": { "type": ["string", "null"] },
                  "example": { "type": ["string", "null"] }
                }
              }
            },
            "request_body": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "content_type": { "type": ["string", "null"] },
                "schema": { "type": ["string", "null"] },
                "description": { "type": ["string", "null"] },
                "example": { "type": ["string", "null"] }
              }
            },
            "responses": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["status_code"],
                "properties": {
                  "status_code": { "type": "integer" },
                  "description": { "type": ["string", "null"] },
                  "schema": { "type": ["string", "null"] },
                  "example": { "type": ["string", "null"] }
                }
              }
            }
          }
        }
      },
      "authentication": {
        "type": "object",
        "additionalProperties": false,
        "required": ["auth_methods"],
        "properties": {
          "auth_methods": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": {
                "type": { "type": "string" },
                "description": { "type": ["string", "null"] },
                "implementation": { "type": ["string", "null"] },
                "example": { "type": ["string", "null"] }
              }
            }
          },
          "api_keys": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "location": { "type": ["string", "null"] },
                "description": { "type": ["string", "null"] }
              }
            }
          }
        }
      },
      "data_models": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "description": { "type": ["string", "null"] },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "type"],
                "properties": {
                  "name": { "type": "string" },
                  "type": { "type": "string" },
                  "required": { "type": "boolean" },
                  "description": { "type": ["string", "null"] },
                  "example": { "type": ["string", "null"] }
                }
              }
            }
          }
        }
      },
      "error_handling": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error_codes"],
        "properties": {
          "error_codes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {
                "code": { "type": "integer" },
                "message": { "type": "string" },
                "description": { "type": ["string", "null"] },
                "resolution": { "type": ["string", "null"] }
              }
            }
          },
          "error_format": { "type": ["string", "null"] },
          "rate_limiting": { "type": ["string", "null"] }
        }
      },
      "examples": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "description"],
          "properties": {
            "title": { "type": "string" },
            "description": { "type": "string" },
            "code": { "type": ["string", "null"] },
            "endpoint": { "type": ["string", "null"] }
          }
        }
      },
      "document_structure": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sections"],
        "properties": {
          "contents_list": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "has_contents": { "type": "boolean" },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "section_id": { "type": "string" },
                    "title": { "type": "string" },
                    "page": { "type": ["integer", "null"] }
                  }
                }
              }
            }
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "level"],
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "level": { "type": "integer", "minimum": 1, "maximum": 6 },
                "numbering": { "type": ["string", "null"] },
                "subsections": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "title", "level"],
                    "properties": {
                      "id": { "type": "string" },
                      "title": { "type": "string" },
                      "level": { "type": "integer" },
                      "numbering": { "type": ["string", "null"] }
                    }
                  }
                }
              }
            }
          },
          "code_blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "code"],
              "properties": {
                "id": { "type": "string" },
                "code": { "type": "string" },
                "language": { "type": ["string", "null"] },
                "section_id": { "type": ["string", "null"] },
                "description": { "type": ["string", "null"] }
              }
            }
          },
          "tables": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "caption"],
              "properties": {
                "id": { "type": "string" },
                "caption": { "type": "string" },
                "section_id": { "type": ["string", "null"] },
                "description": { "type": ["string", "null"] }
              }
            }
          }
        }
      },
      "tone_metadata": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "style": { "type": "string" },
          "formality": { "type": "string" },
          "technical_level": { "type": "string" },
          "key_phrases": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  },
  "operational_guidance": {
    "intended_use": "Semantic distillation of technical documentation including API manuals, user guides, and technical specifications.",
    "migration": {
      "supersedes": null,
      "migrates_cleanly": true,
      "notes": "First version of technical documentation distillation schema."
    }
  }
}


