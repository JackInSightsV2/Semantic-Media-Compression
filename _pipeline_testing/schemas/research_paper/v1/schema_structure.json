{
  "description": "This file shows the structure of the ResearchPaperDistillationBlueprint schema for reference. The full schema with validation rules is in schema.json",
  "schema_structure": {
    "problem_and_motivation": {
      "problem": "string - Problem being addressed",
      "why_it_matters": "string - Why this problem matters",
      "scope": "string (optional) - Scope and boundaries"
    },
    "prior_work": {
      "summary": "string - How this relates to existing approaches",
      "limitations_in_prior_work": "array of strings - Key limitations/gaps"
    },
    "contributions": [
      {
        "id": "string - e.g. C1, C2",
        "description": "string - What is new or improved",
        "changes_or_enables": "string - What it changes or enables"
      }
    ],
    "setup_and_assumptions": {
      "assumptions": ["array of strings"],
      "key_definitions": [
        {
          "term": "string",
          "definition": "string"
        }
      ],
      "validity_constraints": ["array of strings"]
    },
    "methodology": {
      "high_level_description": "string",
      "flow": [
        {
          "step": "string",
          "input": "string",
          "processing": "string",
          "output": "string"
        }
      ],
      "critical_decisions": ["array of strings"],
      "trade_offs": ["array of strings"]
    },
    "results": {
      "quantitative": ["array of strings"],
      "qualitative": ["array of strings"]
    },
    "limitations": {
      "stated": ["array of strings"],
      "implied": ["array of strings"],
      "failure_modes": ["array of strings"]
    },
    "implications": {
      "recommended_uses": ["array of strings"],
      "misuse_risks": ["array of strings"],
      "future_work": ["array of strings"]
    },
    "document_structure": {
      "contents_list": {
        "has_contents": "boolean",
        "items": [
          {
            "section_id": "string",
            "title": "string",
            "page": "integer or null"
          }
        ]
      },
      "sections": [
        {
          "id": "string",
          "title": "string",
          "level": "integer 1-6",
          "numbering": "string or null (e.g. I, II, IIIa)",
          "subsections": [
            {
              "id": "string",
              "title": "string",
              "level": "integer",
              "numbering": "string or null"
            }
          ]
        }
      ],
      "figures": [
        {
          "id": "string",
          "caption": "string",
          "section_id": "string or null",
          "description": "string or null"
        }
      ],
      "tables": [
        {
          "id": "string",
          "caption": "string",
          "section_id": "string or null",
          "description": "string or null"
        }
      ],
      "title_page": {
        "title": "string or null",
        "subtitle": "string or null",
        "author": "string or null",
        "dedication": "string or null",
        "acknowledgments": "string or null"
      },
      "appendix": {
        "has_appendix": "boolean",
        "sections": ["array of strings"]
      }
    },
    "quotes_and_anecdotes": [
      {
        "text": "string - Exact quote text",
        "context": "string - Where it appears",
        "section_id": "string",
        "attribution": "string or null - Author name if known"
      }
    ],
    "tone_metadata": {
      "style": "string - e.g. insider essay, academic paper",
      "urgency_level": "string - high, medium, low",
      "formality": "string - informal, formal, mixed",
      "key_phrases": ["array of strings - Phrases that define the voice"]
    }
  }
}

