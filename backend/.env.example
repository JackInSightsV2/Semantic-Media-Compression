# Application profile
PROFILE=local-dev
API_PREFIX=/api

# Logging
LOG_LEVEL=INFO
LOG_JSON_LOGS=false

# Database (overridden per profile)
DB_URL=postgresql+asyncpg://user:password@localhost:5432/encode
DB_POOL_SIZE=5
DB_ECHO=false

# Storage
STORAGE_BUCKET=story-assets
STORAGE_BASE_PATH=./tmp/assets
STORAGE_SUPABASE_URL=https://your-project.supabase.co
STORAGE_SUPABASE_KEY=your-supabase-service-role-key

# External integrations
EXT_PINATA_JWT=your-pinata-jwt
EXT_STORY_PROTOCOL_API_KEY=your-story-protocol-key
EXT_HF_API_TOKEN=your-huggingface-token
STORY_NAMESPACE_UUID=8a78d159-4f9d-4ec6-85d9-13d8f8f6c70d

# Task processing
TASK_BROKER_URL=redis://localhost:6379/0
TASK_RESULT_BACKEND=redis://localhost:6379/1

# Zero-knowledge encryption
ENCRYPTION_KEY_SIZE=32
