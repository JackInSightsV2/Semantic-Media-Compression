{
  "schema_metadata": {
    "id": "narrative_fiction_distillation",
    "version": "1.1.0",
    "released_at": "2025-11-15T00:00:00Z",
    "draft": "2020-12",
    "hash": "<SHA256 of schema_definition only>",
    "description": "Semantic distillation schema capsule for narrative fiction including novels, short stories, and creative prose.",
    "authors": ["Byte Insights"],
    "license": "proprietary",
    "protection": {
      "integrity_model": "sha256(schema_definition)",
      "storage_guidelines": "Immutable. Hash stored on-chain when necessary.",
      "ip_protection_notes": "Schema capsule is designed to be self-contained for IP locking."
    }
  },
  "schema_definition": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "NarrativeFictionDistillationBlueprint",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "story_overview",
      "characters",
      "plot_structure",
      "setting",
      "themes",
      "narrative_style",
      "document_structure",
      "quotes_and_dialogue",
      "tone_metadata",
      "narrative_sequence",
      "scenes",
      "narrative_flow",
      "storytelling_techniques"
    ],
    "properties": {
      "story_overview": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "summary"],
        "properties": {
          "title": { "type": "string" },
          "author": { "type": ["string", "null"] },
          "summary": { "type": "string" },
          "genre": {
            "type": "array",
            "items": { "type": "string" }
          },
          "point_of_view": { "type": ["string", "null"] },
          "narrative_voice": { "type": ["string", "null"] }
        }
      },
      "characters": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "role"],
          "properties": {
            "name": { "type": "string" },
            "role": { "type": "string" },
            "description": { "type": ["string", "null"] },
            "character_arc": { "type": ["string", "null"] },
            "key_traits": {
              "type": "array",
              "items": { "type": "string" }
            },
            "relationships": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["character", "relationship_type"],
                "properties": {
                  "character": { "type": "string" },
                  "relationship_type": { "type": "string" },
                  "description": { "type": ["string", "null"] }
                }
              }
            }
          }
        }
      },
      "plot_structure": {
        "type": "object",
        "additionalProperties": false,
        "required": ["structure_type"],
        "properties": {
          "structure_type": { "type": "string" },
          "acts_or_chapters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "summary"],
              "properties": {
                "id": { "type": "string" },
                "title": { "type": ["string", "null"] },
                "summary": { "type": "string" },
                "key_events": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "character_developments": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "inciting_incident": { "type": ["string", "null"] },
          "climax": { "type": ["string", "null"] },
          "resolution": { "type": ["string", "null"] },
          "key_turning_points": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "setting": {
        "type": "object",
        "additionalProperties": false,
        "required": ["primary_setting"],
        "properties": {
          "primary_setting": { "type": "string" },
          "time_period": { "type": ["string", "null"] },
          "locations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "description": { "type": ["string", "null"] },
                "significance": { "type": ["string", "null"] }
              }
            }
          },
          "atmosphere": { "type": ["string", "null"] },
          "world_building_elements": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "themes": {
        "type": "object",
        "additionalProperties": false,
        "required": ["primary_themes"],
        "properties": {
          "primary_themes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "secondary_themes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "symbolism": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["symbol"],
              "properties": {
                "symbol": { "type": "string" },
                "meaning": { "type": ["string", "null"] }
              }
            }
          },
          "moral_questions": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "narrative_style": {
        "type": "object",
        "additionalProperties": false,
        "required": ["style_description"],
        "properties": {
          "style_description": { "type": "string" },
          "pacing": { "type": ["string", "null"] },
          "tone_shifts": {
            "type": "array",
            "items": { "type": "string" }
          },
          "sentence_structure_patterns": {
            "type": "array",
            "items": { "type": "string" }
          },
          "rhetorical_devices": {
            "type": "array",
            "items": { "type": "string" }
          },
          "literary_devices": {
            "type": "array",
            "items": { "type": "string" }
          },
          "dialogue_style": { "type": ["string", "null"] },
          "descriptive_style": { "type": ["string", "null"] },
          "narrative_voice_characteristics": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "document_structure": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sections"],
        "properties": {
          "contents_list": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "has_contents": { "type": "boolean" },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "section_id": { "type": "string" },
                    "title": { "type": "string" },
                    "page": { "type": ["integer", "null"] }
                  }
                }
              }
            }
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "level"],
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "level": { "type": "integer", "minimum": 1, "maximum": 6 },
                "numbering": { "type": ["string", "null"] },
                "subsections": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "title", "level"],
                    "properties": {
                      "id": { "type": "string" },
                      "title": { "type": "string" },
                      "level": { "type": "integer" },
                      "numbering": { "type": ["string", "null"] }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "quotes_and_dialogue": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "text": { "type": "string" },
            "speaker": { "type": ["string", "null"] },
            "context": { "type": ["string", "null"] },
            "section_id": { "type": ["string", "null"] },
            "scene_id": { "type": ["string", "null"] },
            "chapter_id": { "type": ["string", "null"] },
            "narrative_position": { "type": ["string", "null"] },
            "function": { "type": ["string", "null"] },
            "significance": { "type": ["string", "null"] }
          }
        }
      },
      "tone_metadata": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "overall_tone": { "type": "string" },
          "mood": { "type": "string" },
          "style": { "type": "string" },
          "key_phrases": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "narrative_sequence": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "chronological_order": {
            "type": "array",
            "items": { "type": "string" }
          },
          "narrative_order": {
            "type": "array",
            "items": { "type": "string" }
          },
          "narrative_techniques": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "scenes": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scene_id", "summary"],
          "properties": {
            "scene_id": { "type": "string" },
            "chapter_or_act": { "type": ["string", "null"] },
            "location": { "type": ["string", "null"] },
            "characters_present": {
              "type": "array",
              "items": { "type": "string" }
            },
            "summary": { "type": "string" },
            "purpose": { "type": ["string", "null"] },
            "key_dialogue": {
              "type": "array",
              "items": { "type": "string" }
            },
            "narrative_function": { "type": ["string", "null"] }
          }
        }
      },
      "narrative_flow": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "opening_technique": { "type": ["string", "null"] },
          "pacing_pattern": { "type": ["string", "null"] },
          "tension_arc": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["point", "tension_level", "description"],
              "properties": {
                "point": { "type": "string" },
                "tension_level": { "type": "string" },
                "description": { "type": "string" }
              }
            }
          },
          "climax_position": { "type": ["string", "null"] },
          "resolution_style": { "type": ["string", "null"] }
        }
      },
      "storytelling_techniques": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "frame_narrative": { "type": ["boolean", "null"] },
          "unreliable_narrator": { "type": ["boolean", "null"] },
          "multiple_perspectives": { "type": ["boolean", "null"] },
          "time_manipulation": {
            "type": "array",
            "items": { "type": "string" }
          },
          "narrative_breaks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "position", "purpose"],
              "properties": {
                "type": { "type": "string" },
                "position": { "type": "string" },
                "purpose": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "operational_guidance": {
    "intended_use": "Semantic distillation of narrative fiction including novels, short stories, and creative prose.",
    "migration": {
      "supersedes": "1.0.0",
      "migrates_cleanly": true,
      "notes": "Enhanced with narrative sequence, scenes, narrative flow, storytelling techniques, and improved dialogue mapping. Added detailed narrative style characteristics."
    }
  }
}

