# Public, non-secret configuration only. Browser credentialed writes are disabled.
# Never put wallet private keys, Pinata JWTs or API secrets in NEXT_PUBLIC_*.
# No backend consumes server-only secrets yet; adding keys will not enable writes.
NEXT_PUBLIC_WALLET_ADDRESS=
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=
NEXT_PUBLIC_STORY_RPC_URL=https://aeneid.storyrpc.io
NEXT_PUBLIC_STORY_CHAIN_ID=1315
