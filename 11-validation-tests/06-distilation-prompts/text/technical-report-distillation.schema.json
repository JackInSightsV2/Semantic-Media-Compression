{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semantic-media-compression.local/schemas/technical-report-distillation.schema.json",
  "title": "TechnicalReportDistillationBlueprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "problem_and_motivation",
    "prior_work",
    "contributions",
    "setup_and_assumptions",
    "methodology",
    "results",
    "limitations",
    "implications"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "0.0.1",
      "description": "Schema version of the distillation blueprint."
    },
    "problem_and_motivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem", "why_it_matters"],
      "properties": {
        "problem": { "type": "string" },
        "why_it_matters": { "type": "string" },
        "scope": { "type": "string" }
      }
    },
    "prior_work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": { "type": "string" },
        "limitations_in_prior_work": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "contributions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "changes_or_enables": { "type": "string" }
        }
      }
    },
    "setup_and_assumptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assumptions"],
      "properties": {
        "assumptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "key_definitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["term", "definition"],
            "properties": {
              "term": { "type": "string" },
              "definition": { "type": "string" }
            }
          }
        },
        "validity_constraints": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["high_level_description", "flow"],
      "properties": {
        "high_level_description": { "type": "string" },
        "flow": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["step_id", "description"],
            "properties": {
              "step_id": { "type": "string" },
              "description": { "type": "string" },
              "inputs": {
                "type": "array",
                "items": { "type": "string" }
              },
              "outputs": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "experimental_design": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "datasets": {
              "type": "array",
              "items": { "type": "string" }
            },
            "baselines": {
              "type": "array",
              "items": { "type": "string" }
            },
            "metrics": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quantitative", "qualitative"],
      "properties": {
        "quantitative": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description"],
            "properties": {
              "description": { "type": "string" },
              "compared_to": { "type": "string" }
            }
          }
        },
        "qualitative": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stated", "implied"],
      "properties": {
        "stated": {
          "type": "array",
          "items": { "type": "string" }
        },
        "implied": {
          "type": "array",
          "items": { "type": "string" }
        },
        "failure_modes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "implications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended_uses"],
      "properties": {
        "recommended_uses": {
          "type": "array",
          "items": { "type": "string" }
        },
        "misuse_risks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "future_work": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}


