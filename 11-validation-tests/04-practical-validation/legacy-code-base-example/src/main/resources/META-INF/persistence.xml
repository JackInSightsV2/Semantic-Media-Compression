<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://java.sun.com/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://java.sun.com/xml/ns/persistence 
             http://java.sun.com/xml/ns/persistence/persistence_2_0.xsd"
             version="2.0">
    
    <persistence-unit name="LegacyHRPU" transaction-type="JTA">
        <provider>org.hibernate.ejb.HibernatePersistence</provider>
        
        <!-- Legacy entity classes -->
        <class>com.legacy.enterprise.model.Employee</class>
        <class>com.legacy.enterprise.model.PayrollCalculation</class>
        <class>com.legacy.enterprise.model.BenefitEnrollment</class>
        <class>com.legacy.enterprise.model.TimeEntry</class>
        <class>com.legacy.enterprise.model.TaxDeduction</class>
        <class>com.legacy.enterprise.model.PerformanceReview</class>
        <class>com.legacy.enterprise.model.LegacyAuditLog</class>
        
        <!-- Legacy properties -->
        <properties>
            <!-- Database connection -->
            <property name="hibernate.connection.driver_class" value="com.mysql.jdbc.Driver"/>
            <property name="hibernate.connection.url" value="jdbc:mysql://localhost:3306/legacy_hr?useSSL=false&amp;serverTimezone=UTC"/>
            <property name="hibernate.connection.username" value="legacy_user"/>
            <property name="hibernate.connection.password" value="legacy_password"/>
            
            <!-- Hibernate settings -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQL5Dialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.use_sql_comments" value="true"/>
            
            <!-- Legacy connection pool settings -->
            <property name="hibernate.connection.pool_size" value="10"/>
            <property name="hibernate.connection.autocommit" value="false"/>
            <property name="hibernate.connection.isolation" value="4"/>
            
            <!-- Legacy cache settings -->
            <property name="hibernate.cache.use_second_level_cache" value="true"/>
            <property name="hibernate.cache.use_query_cache" value="true"/>
            <property name="hibernate.cache.region.factory_class" value="org.hibernate.cache.ehcache.EhCacheRegionFactory"/>
            
            <!-- Legacy transaction settings -->
            <property name="hibernate.transaction.factory_class" value="org.hibernate.transaction.JTATransactionFactory"/>
            <property name="hibernate.transaction.manager_lookup_class" value="org.hibernate.transaction.JBossTransactionManagerLookup"/>
            
            <!-- Legacy validation settings -->
            <property name="hibernate.validator.apply_to_ddl" value="false"/>
            <property name="hibernate.validator.autoregister_listeners" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
